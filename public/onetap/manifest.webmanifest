{
  "name": "ONE TAP",
  "short_name": "ONE TAP",
  "description": "Turn anything you see into an action with one tap.",
  "id": "/onetap",
  "start_url": "/onetap",
  "scope": "/onetap",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#08080a",
  "theme_color": "#08080a",
  "categories": ["productivity", "utilities"],
  "icons": [
    { "src": "/onetap/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/onetap/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/onetap/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "/onetap/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        { "name": "image", "accept": ["image/png", "image/jpeg", "image/webp", "image/heic", "image/heif", "image/*"] }
      ]
    }
  }
}
