{
  "name": "ONE TAP",
  "short_name": "ONE TAP",
  "description": "Turn anything you see into an action with one tap.",
  "id": "/onetap",
  "start_url": "/onetap",
  "scope": "/onetap",
  "lang": "it",
  "dir": "ltr",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#08080a",
  "theme_color": "#08080a",
  "categories": [
    "productivity",
    "utilities"
  ],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/onetap/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/onetap/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/onetap/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/onetap/screenshots/home.png",
      "sizes": "780x1688",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Fotografa, incolla o condividi: ONE TAP legge e propone l'azione"
    },
    {
      "src": "/onetap/screenshots/calendar.png",
      "sizes": "780x1688",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Una locandina diventa un evento in calendario con un tocco"
    },
    {
      "src": "/onetap/screenshots/note.png",
      "sizes": "780x1688",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Una lavagna diventa una nota ordinata da salvare"
    }
  ],
  "share_target": {
    "action": "/onetap/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "image",
          "accept": [
            "image/png",
            "image/jpeg",
            "image/webp",
            "image/heic",
            "image/heif",
            "image/*"
          ]
        }
      ]
    }
  },
  "shortcuts": [
    {
      "name": "Capture",
      "short_name": "Capture",
      "url": "/onetap",
      "icons": [
        {
          "src": "/onetap/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Set up sharing",
      "short_name": "Set up",
      "url": "/onetap/install",
      "icons": [
        {
          "src": "/onetap/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
