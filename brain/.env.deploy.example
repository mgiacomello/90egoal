# Copia in .env.deploy (è ignorato da git) e lancia: node scripts/go-live.mjs

# --- Vercel (obbligatorio) ---
VERCEL_TOKEN=                      # https://vercel.com/account/tokens
# VERCEL_TEAM_ID=team_...          # solo se hai più di un team
# VERCEL_PROJECT_NAME=brain
# GITHUB_REPO=mgiacomello/90egoal
# GITHUB_BRANCH=main

# --- Supabase: migration automatiche (facoltativo) ---
# SUPABASE_ACCESS_TOKEN=sbp_...    # https://supabase.com/dashboard/account/tokens

# --- Le variabili di BRAIN (vedi README, "Configurazione") ---
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
BRAIN_OWNER_EMAIL=
ANTHROPIC_API_KEY=
# CRON_SECRET=                     # se manca lo genera lo script
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# BRAIN_APP_URL=                   # se manca la imposta lo script al dominio Vercel
# RESEND_API_KEY=
# BRAIN_MAIL_FROM=
# QONTO_LOGIN=
# QONTO_SECRET_KEY=
# OURA_TOKEN=
